# ─── Server ────────────────────────────────────────────────────────────────
# Local Node dev only. Cloudflare Workers reads the same variables from
# wrangler.jsonc `vars` + dashboard secrets (see wrangler.jsonc comments).
PORT=4000
NODE_ENV=development

# JWT secret used to sign the CRM's own auth tokens (any long random string).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Supabase (single merged project) ─────────────────────────────────────
# Project URL + API keys from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Resend (optional — omit to log emails to the console) ────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=TradePro CRM <onboarding@resend.dev>
RESEND_REPLY_TO=sales@yourdomain.com

# ─── Public email capture endpoint ─────────────────────────────────────────
# When REQUIRE_CAPTURE_SECRET=1, clients must send this secret in an
# `x-capture-secret` header. Leave empty to keep the endpoint public.
REQUIRE_CAPTURE_SECRET=0
CAPTURE_SECRET=

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── ReviewFlow integration (now the SAME Supabase project) ───────────────
# REVIEWFLOW_URL is the merged Supabase project URL — the edge functions live
# under /functions/v1. Set both URL + SECRET to enable the combined experience:
#   lead-won / project-completed -> ReviewFlow lead + review email;
#   review-status badges; the full Reviews dashboard under one login.
#
# REVIEWFLOW_SECRET must match the INTEGRATION_SECRET set on the edge functions.
# REVIEWFLOW_URL is identical to SUPABASE_URL in this merged deploy.
REVIEWFLOW_URL=https://your-project.supabase.co
REVIEWFLOW_SECRET=shared-integration-secret
REVIEWFLOW_AUTO_SEND=true

# ─── Cloudflare Workers deployment ─────────────────────────────────────────
# See wrangler.jsonc — deploy with:  npm run deploy:worker
# Secrets are set via `wrangler secret put` (never in wrangler.jsonc):
#   wrangler secret put JWT_SECRET
#   wrangler secret put SUPABASE_SERVICE_KEY
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put CAPTURE_SECRET
#   wrangler secret put REVIEWFLOW_SECRET   (must equal edge INTEGRATION_SECRET)
# Non-secret vars (SUPABASE_URL, SUPABASE_ANON_KEY, REVIEWFLOW_URL,
# CORS_ORIGIN, REVIEWFLOW_AUTO_SEND, NODE_ENV) go in wrangler.jsonc `vars`.