{
  // crm-with-reviews — merged CRM + Reviews API (Cloudflare Worker).
  // Express runs inside the Worker via the node:http compatibility layer.
  // Deploy:  npm run deploy:worker  (or  wrangler deploy --config wrangler.jsonc)
  //
  // keep_vars: preserves plain-text variables that were set in the Cloudflare
  // dashboard instead of deleting them on deploy. In Wrangler 4.x it compiles
  // to `keep_bindings: ["plain_text","json"]` in the upload metadata — no extra
  // dashboard API call — so it is safe inside Worker Builds. Secrets are never
  // deleted by a deploy (wrangler hardcodes keep_secrets: true), so JWT_SECRET
  // and friends set in the dashboard survive regardless of this flag.
  //
  // Keys listed in "vars" below are still applied from this file and overwrite
  // same-named dashboard values. Remove a key here if the dashboard should own
  // it.
  //
  //  Non-secret variables → declared in "vars" below.
  //  Secrets              → set in the Cloudflare dashboard (Worker → Settings
  //                         → Variables and Secrets) or `wrangler secret put`:
  //                            JWT_SECRET
  //                            SUPABASE_SERVICE_KEY
  //                            RESEND_API_KEY
  //                            INTEGRATION_SECRET   (= REVIEWFLOW_SECRET alias)
  //                            CAPTURE_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepro-combined",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "keep_vars": true,
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "https://tradepro-combined.pages.dev",
    "REVIEWFLOW_AUTO_SEND": "true",
    "SUPABASE_URL": "https://kyysddfdrgdocbxyrvqp.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt5eXNkZGZkcmdkb2NieHlydnFwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI3NTk3MjgsImV4cCI6MjEwODMzNTcyOH0.7siGOX36y-XXpvQOSc-_5iS3KP_9DXxlJc-pv-WDlP8",
    "REVIEWFLOW_URL": "https://kyysddfdrgdocbxyrvqp.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}