# Local-only runtime variables for `npm run dev:worker` (wrangler dev).
# Copy to server/.dev.vars (gitignored). Production values live in the
# Cloudflare dashboard — see the comment block at the end of wrangler.jsonc.
#
# `npm run dev` (Node/tsx) does not read this file; it uses server/.env.

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
COOKIE_DOMAIN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

REVIEWFLOW_URL=https://your-project.supabase.co
REVIEWFLOW_AUTO_SEND=true

JWT_SECRET=change-me-to-a-long-random-string
ALLOW_BEARER_AUTH=true
CRON_SECRET=local-only-replace-with-32-characters
INTEGRATION_SECRET=local-only-replace-with-32-characters
RESEND_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=TradePro CRM <hello@example.test>

# Required when the invoicing share endpoints are enabled
SV_API_KEY=
