# ─── Client build-time env (Vite) ──────────────────────────────────────────
# Copy to .env for local dev. On Cloudflare Pages set these in the
# build environment (Settings → Builds & deployments → Environment variables).

# Browser → API Worker base URL. Empty for local dev (Vite proxies /api to
# the server). In production this is your deployed Worker URL, e.g.
# https://crm-with-reviews-api.your-account.workers.dev
VITE_API_URL=

# Public app URL (used to build the widget SCRIPT tag in the Settings page).
# In production this is your Cloudflare Pages domain, e.g.
# https://crm-with-reviews.pages.dev
VITE_APP_URL=http://localhost:5173

# The SINGLE merged Supabase project URL (used only to build the embeddable
# widget snippets — widget.js reads data-supabase-url at runtime, and this
# value is the fallback baked in at build time).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Feature flag: enables the Reviews tab + review-status badges.
VITE_ENABLE_REVIEWS_INTEGRATION=true

# API request timeout in ms (default 20000).
VITE_API_TIMEOUT_MS=20000