# ─── Edge function secrets (supabase/.env.local for local dev) ────────────
# Copy to supabase/.env.local. In production set these per function with
# `supabase secrets set` (see SETUP-GUIDE.md §2.2).

# The single merged Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# service_role key of the SAME project (edge functions bypass RLS and scope
# every query by user_id).
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key used to send review emails.
RESEND_API_KEY=

# Shared secret between the CRM Worker (REVIEWFLOW_SECRET) and these edge
# functions. The dashboard never calls edge functions directly — only the
# Worker does, presenting this secret + the authenticated user's id.
INTEGRATION_SECRET=