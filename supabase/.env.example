# ─── Edge function secrets (supabase/.env.local for local dev) ────────────
# Copy to supabase/.env.local. In production set these per function with
# `supabase secrets set` (see SETUP-GUIDE.md §2.2).

# The single merged Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# service_role key of the SAME project (edge functions bypass RLS and scope
# every query by user_id).
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key used to send review emails.
RESEND_API_KEY=

# Shared secret between the CRM Worker (REVIEWFLOW_SECRET or INVOICING_SECRET)
# and these edge functions. The dashboard never calls edge functions directly —
# only the Worker does, presenting this secret + the authenticated user's id.
INTEGRATION_SECRET=

# ─── Invoicing edge functions (secrets per function, optional pieces) ─────
# invoicing-cron needs CRON_SECRET (schedule auth) and RESEND_API_KEY +
# INVOICING_FROM_EMAIL to send reminders. invoicing-resend-webhook needs
# RESEND_WEBHOOK_SECRET (verifySignature). invoicing-api + invoicing-public
# need nothing beyond SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY unless you want
# live email (RESEND_API_KEY + INVOICING_FROM_EMAIL). See SETUP-GUIDE §8.
CRON_SECRET=change-me
INVOICING_FROM_EMAIL=TradePro <no-reply@resend.dev>
RESEND_WEBHOOK_SECRET=change-me
# Should be the deployed Pages URL (e.g. https://crm-with-reviews.pages.dev):
# it prefixes the /q/:token and /i/:token share links placed in sent emails.
APP_URL=https://your-app.example.com

# Authentication the invoicing-api edge function expects from the Worker:
#  - INTEGRATION_SECRET == Worker's INVOICING_SECRET
#  - X_API_KEY          == Worker's SV_API_KEY (second factor for pdf/view/download)